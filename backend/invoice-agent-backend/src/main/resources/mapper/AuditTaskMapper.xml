<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="invoice_agent_backend.mapper.AuditTaskMapper">

    <resultMap id="AuditTaskResultMap" type="invoice_agent_backend.entity.AuditTask">
        <id property="id" column="id"/>
        <result property="taskNo" column="task_no"/>
        <result property="userId" column="user_id"/>
        <result property="status" column="status"/>
        <result property="originalFilePath" column="original_file_path"/>
        <result property="ocrRawText" column="ocr_raw_text"/>
        <result property="finalDecision" column="final_decision"/>
        <result property="needHumanReview" column="need_human_review"/>
        <result property="reportPath" column="report_path"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insertAuditTask" parameterType="invoice_agent_backend.entity.AuditTask"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO audit_task (
        task_no,
        user_id,
        status,
        original_file_path,
        ocr_raw_text,
        final_decision,
        need_human_review,
        report_path
        )
        VALUES (
        #{taskNo},
        #{userId},
        #{status},
        #{originalFilePath},
        #{ocrRawText},
        #{finalDecision},
        #{needHumanReview},
        #{reportPath}
        )
    </insert>

    <select id="selectAuditTaskById" parameterType="long" resultMap="AuditTaskResultMap">
        SELECT
        id,
        task_no,
        user_id,
        status,
        original_file_path,
        ocr_raw_text,
        final_decision,
        need_human_review,
        report_path,
        created_at,
        updated_at
        FROM audit_task
        WHERE id = #{id}
    </select>

    <!--
    通用任务状态更新。

    除了根据任务 ID 更新，
    还要求数据库中的状态必须与 currentStatus 相同。

    例如：
    UPLOADED -> OCR_PROCESSING

    如果数据库中的状态已经不是 UPLOADED，
    SQL 更新行数就会是 0。
-->
    <update id="updateTaskStatus">

        UPDATE audit_task

        SET
        status = #{targetStatus},
        updated_at = NOW()

        WHERE id = #{id}
        AND status = #{currentStatus}

    </update>

    <!--
        OCR 成功后保存 OCR 原始内容。
        状态由 Lifecycle Service 单独更新。
    -->
    <update id="updateTaskAfterOcr">

        UPDATE audit_task

        SET
        ocr_raw_text = #{ocrRawText},
        updated_at = NOW()

        WHERE id = #{id}

    </update>

    <!--
        保存自动审核结论。
        状态由 Lifecycle Service 单独更新。
    -->
    <update id="updateAuditResult">

        UPDATE audit_task

        SET
        final_decision = #{finalDecision},
        need_human_review = #{needHumanReview},
        updated_at = NOW()

        WHERE id = #{id}

    </update>

    <update id="updateReportPath">
        UPDATE audit_task
        SET
        report_path = #{reportPath},
        updated_at = NOW()
        WHERE id = #{id}
    </update>

    <!--
    任务列表分页查询

    status 为空：
    查询所有任务

    status 不为空：
    只查询对应状态
-->
    <select id="selectAuditTaskPage"
            resultMap="AuditTaskResultMap">

        SELECT
        id,
        task_no,
        user_id,
        status,
        original_file_path,
        ocr_raw_text,
        final_decision,
        need_human_review,
        report_path,
        created_at,
        updated_at
        FROM audit_task

        <where>
            <if test="status != null and status != ''">
                status = #{status}
            </if>
        </where>

        ORDER BY id DESC

        LIMIT #{offset}, #{size}

    </select>


    <!-- 查询任务总数 -->
    <select id="countAuditTasks"
            resultType="long">

        SELECT COUNT(1)
        FROM audit_task

        <where>
            <if test="status != null and status != ''">
                status = #{status}
            </if>
        </where>

    </select>


    <!--
        保存人工审核的最终结论。
        AUDIT_DONE -> COMPLETED
        由 Lifecycle Service 单独完成。
    -->
    <update id="updateHumanReviewResult">

        UPDATE audit_task

        SET
        final_decision = #{finalDecision},
        need_human_review = #{needHumanReview},
        updated_at = NOW()

        WHERE id = #{id}

    </update>

</mapper>